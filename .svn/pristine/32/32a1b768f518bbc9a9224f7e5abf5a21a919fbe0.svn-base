#include "opt_problems.h"
#include "analysis_NURBSCurve.h"

pair<vector_double, vector_double> opt_problem::get_bounds() const
{
	vector<double> lb = m_lb.size() ? m_lb : vector<double>(m_problem_size, 0);
	vector<double> ub = m_ub.size() ? m_ub : vector<double>(m_problem_size, 1);
	return { lb,ub };
}

void opt_problem::set_bounds(vector<double> lb, vector<double> ub)
{
	if (lb.size() == m_problem_size)
		m_lb = lb;
	if (ub.size() == m_problem_size)
		m_ub = ub;
}

opt_max_concentration1::opt_max_concentration1(const opt_max_concentration1& o)
{
	m_problem_size = o.m_problem_size;
	m_lb = o.m_lb;
	m_ub = o.m_ub;
	m_area = o.m_area;
	m_data = o.m_data;
}

vector_double opt_max_concentration1::fitness(const vector_double& v) const
{
	analysis_curves curves;
	curves.CurveFromParameters_pm1(v, 2);
	curves.RefineCurve(m_data.refinement_level);
	curves.ComputeFieldOnSingleCurve_TBB(m_data.wavelength, m_data.waveangle, m_data.sigma);
	double bal = 0;
	try {
		bal = curves.CalculateQuantityOnMesh_GSL(m_data.wavelength, m_data.waveangle, m_data.sigma) * -1;
	}
	catch (...) {
		cout << "Area:" << curves.CurveArea() << endl << flush;
		return { 0 };
	}
	return { bal };
}