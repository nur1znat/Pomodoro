	MPI_Bcast(&buf_size, 1, MPI_INT, root, MPI_COMM_WORLD);
	
	broadcastCurveData(curves, buf_size, my_rank, root, MPI_COMM_WORLD);
	MPI_Barrier(MPI_COMM_WORLD);
	
	if (my_rank == root) {
		cout << "Solution using Simpson's integration with multiple cores:\n";
		t1 = MPI_Wtime();
	}
	curves.ComputeFieldOnSingleCurve_MPI(1, 0, complex<double>(0.002652582384865, -0.000530516476973), 0, 1e-4);
	if (my_rank == root)
