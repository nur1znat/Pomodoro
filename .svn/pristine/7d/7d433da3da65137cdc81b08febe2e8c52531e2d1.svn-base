				valarray<valarray<double> > Bases = curves.ComputeBasisValues(pv);
				for (unsigned int i = 0; i < curves.DoFs()[0]; i++) {
					for (unsigned int j = 0; j < pv.size(); j++)
						cout << Bases[j][i] << ",";
					cout << endl;
				}*/

				//generate a curve and save it.
				/*vector<double> params{ 0.1, 0.5, 0.5, 0.1, 0.5, 0.5, 0.5, 0.1, 0.5, 0.5 };
				curves.CurveFromParameters_pm1(params, 1);
				curves.RefineCurve(3);
				curves.CalculateQuantityOnMesh();*/

				/*//TESTING basis function 
				vector<double> pv(51);
				pv[0] = 0; pv[50] = 1;
				for (unsigned int i = 1; i < 50; i++)
					pv[i] = pv[i-1]+0.02;
				valarray<valarray<double> > Bases=curves.ComputeBasisValues(pv);
				for (unsigned int i = 0; i < 23; i++) {
					for (unsigned int j = 0; j < 51; j++)
						cout << Bases[j][i] << ",";
					cout << endl;
				}*/
				/*cout << "\nTesting simple Green Function:\n";
				Point p(1, 0.2);
				Point p0(0.2, 0.1);
				complex<double> res = Green(p0, p, 1);
				cout << "(" << format << real(res) << "," << format << imag(res) << ")\n";
				cout << "\nTesting multi-valued Green Function:\n";
				vector<Point> p1(3);
				p1[0] = Point(1, 0.2);
				p1[1] = Point(.5, 0.2);
