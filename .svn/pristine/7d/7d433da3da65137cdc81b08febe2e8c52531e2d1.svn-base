				cout << "_________________________\n";
				cout << "Solution using Adaptive Gauss-Kronrod integration with one core:\n";
				startTime = clock();
				curves.ComputeFieldOnSingleCurve_GSL(1, 0, complex<double>(0.002652582384865, -0.000530516476973), 0);
				timed2 = double(clock() - startTime) / (double)CLOCKS_PER_SEC;
				cout << "_________________________\n";
				/*valarray<double> pv(51);
				pv[0] = 0; pv[50] = 1;
				for (unsigned int i = 1; i < pv.size() - 1; i++)
					pv[i] = pv[i - 1] + 0.02;
				vector<vector<Point> > points = curves.ComputeCurvePoints(pv, 1);
				for (unsigned int i = 0; i < points.size(); i++)
				{
					for (unsigned int j = 0; j < 2; j++)
						cout << point2str(points[i][j],true);
				}*/
				//TESTING basis function 
				/*vector<double> pv(51);
				pv[0] = 0; pv[50] = 1;
				for (unsigned int i = 1; i < pv.size()-1; i++)
