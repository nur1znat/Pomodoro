		cout << "Elapsed time using "<<number_of_processes<<" core(s) is " << t2 - t1 <<endl;
	}
	MPI_Finalize();
	return EXIT_SUCCESS;
}

void broadcastCurveData(analysis_curves& curves, int buf_size, int rank, int root, MPI_Comm communicator)
{
	double* ctrl_pts = 0;
	double* knots = 0;
	char* packbuffer = new char[buf_size];
	int packposition;
	int nCurves;
	int* n_cps = 0;
	int* order = 0;
	bool* rational = 0;
	if (rank == root)
	{
		packposition = 0;
		nCurves = curves.nCurves();
		n_cps = new int[2 * nCurves];
		order = new int[2 * nCurves];
		rational = new bool[2 * nCurves];
		for (unsigned int i = 0; i < nCurves; i++) {
			n_cps[i] = curves[i].numCoefs();
			order[i] = curves[i].order();
			rational[i] = curves[i].rational();
			n_cps[i + nCurves] = curves.getAnalysisCurve(i).numCoefs();
			order[i + nCurves] = curves.getAnalysisCurve(i).order();
			rational[i + nCurves] = curves.getAnalysisCurve(i).rational();
		}
		MPI_Pack(n_cps, 2 * nCurves, MPI_INT, packbuffer, buf_size, &packposition, communicator);
		MPI_Pack(order, 2 * nCurves, MPI_INT, packbuffer, buf_size, &packposition, communicator);
		MPI_Pack(rational, 2 * nCurves, MPI_CXX_BOOL, packbuffer, buf_size, &packposition, communicator);
		for (unsigned int i = 0; i < nCurves; i++) {
			ctrl_pts = new double[n_cps[i]*4];
			knots = new double[n_cps[i] + order[i]];
			unsigned int j = 0;
			for (vector< double >::const_iterator it = curves[i].rcoefs_begin(); it < curves[i].rcoefs_end(); it++)
				ctrl_pts[j++] = *it;
			j = 0;
			for (vector< double >::const_iterator it = curves[i].knotsBegin(); it < curves[i].knotsEnd(); it++)
				knots[j++] = *it;
			MPI_Pack(ctrl_pts, n_cps[i]*4, MPI_DOUBLE, packbuffer, buf_size, &packposition, communicator);
			MPI_Pack(knots, n_cps[i] + order[i], MPI_DOUBLE, packbuffer, buf_size, &packposition, communicator);
			delete[] ctrl_pts;
			delete[] knots;
			ctrl_pts = new double[n_cps[i+nCurves] * 4];
			knots = new double[n_cps[i+nCurves] + order[i+nCurves]];
			j = 0;
			for (vector< double >::const_iterator it = curves.getAnalysisCurve(i).rcoefs_begin(); it < curves.getAnalysisCurve(i).rcoefs_end(); it++)
				ctrl_pts[j++] = *it;
			j = 0;
			for (vector< double >::const_iterator it = curves.getAnalysisCurve(i).knotsBegin(); it < curves.getAnalysisCurve(i).knotsEnd(); it++)
				knots[j++] = *it;
			MPI_Pack(ctrl_pts, n_cps[i+nCurves] * 4, MPI_DOUBLE, packbuffer, buf_size, &packposition, communicator);
			MPI_Pack(knots, n_cps[i+ nCurves] + order[i+ nCurves], MPI_DOUBLE, packbuffer, buf_size, &packposition, communicator);
			delete[] ctrl_pts;
			delete[] knots;
			ctrl_pts = 0;
			knots = 0;
		}
	}
	MPI_Bcast(&nCurves, 1, MPI_INT, root, communicator);
	MPI_Bcast(packbuffer, buf_size, MPI_PACKED, root, communicator);
	if (rank != root)
	{
		packposition = 0;
		n_cps = new int[2 * nCurves];
		order = new int[2 * nCurves];
		rational = new bool[2 * nCurves];
		MPI_Unpack(packbuffer, buf_size, &packposition, n_cps, 2 * nCurves, MPI_INT, MPI_COMM_WORLD);
		MPI_Unpack(packbuffer, buf_size, &packposition, order, 2 * nCurves, MPI_INT, MPI_COMM_WORLD);
		MPI_Unpack(packbuffer, buf_size, &packposition, rational, 2 * nCurves, MPI_CXX_BOOL, MPI_COMM_WORLD);
		for (unsigned int i = 0; i < nCurves; i++) {
			ctrl_pts = new double[n_cps[i] * 4];
			knots = new double[n_cps[i] + order[i]];
			MPI_Unpack(packbuffer, buf_size, &packposition, ctrl_pts, 4 * n_cps[i], MPI_DOUBLE, MPI_COMM_WORLD);
			MPI_Unpack(packbuffer, buf_size, &packposition, knots, n_cps[i] + order[i], MPI_DOUBLE, MPI_COMM_WORLD);
			SplineCurve curve = SplineCurve(n_cps[i], order[i], knots, ctrl_pts, 3, rational[i]);
			curves.addCurve(curve);
			delete[] ctrl_pts;
			delete[] knots;
			ctrl_pts = new double[n_cps[i+nCurves] * 4];
			knots = new double[n_cps[i+nCurves] + order[nCurves+i]];
			MPI_Unpack(packbuffer, buf_size, &packposition, ctrl_pts, 4 * n_cps[i+nCurves], MPI_DOUBLE, MPI_COMM_WORLD);
			MPI_Unpack(packbuffer, buf_size, &packposition, knots, n_cps[i+nCurves] + order[i+nCurves], MPI_DOUBLE, MPI_COMM_WORLD);
			curve = SplineCurve(n_cps[i+nCurves], order[i+nCurves], knots, ctrl_pts, 3, rational[i+nCurves]);
			curves.addAnalysisCurve(curve);
			delete[] ctrl_pts;
			delete[] knots;
		}
		curves.CalculateGreville();
		/*for (unsigned int i = 0; i < nCurves; i++) {
			string str = string( "myrank " + to_string(rank) + ":\n");
			cout << str + curves.PrintCurveInfo(i) + curves.PrintCurveInfo(i, true);
		
		}*/
	}
	delete[] packbuffer;
	delete[] n_cps;
	delete[] order;
	delete[] rational;
}